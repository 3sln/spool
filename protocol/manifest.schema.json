{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:3sln:spool:manifest:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "client_request_id", "task_timeout_s", "platform", "environment", "command", "resources", "network"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "client_request_id": { "type": "string", "pattern": "^[a-zA-Z0-9._:-]{1,128}$" },
    "task_timeout_s": { "type": "integer", "minimum": 1, "maximum": 2147483 },
    "platform": {
      "type": "object", "additionalProperties": false, "required": ["os", "arch"],
      "properties": { "os": { "const": "linux" }, "arch": { "const": "amd64" } }
    },
    "environment": {
      "type": "object", "additionalProperties": false, "required": ["base", "layers"],
      "properties": {
        "base": {
          "type": "object", "additionalProperties": false, "required": ["id", "digest"],
          "properties": { "id": { "const": "spool-debian12-workspace" }, "digest": { "const": "sha256:311f7a192fd9a92b165a86b32fa3aae9005b11849bfb1db2d4fd784559ee464f" } }
        },
        "layers": {
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["digest", "media_type", "size"],
            "properties": {
              "digest": { "$ref": "#/$defs/digest" },
              "media_type": { "enum": ["application/vnd.oci.image.layer.v1.tar", "application/vnd.oci.image.layer.v1.tar+gzip", "application/vnd.spool.workspace.patch.v1+vcdiff"] },
              "size": { "type": "integer", "minimum": 1, "maximum": 2147483648 }
            }
          }
        }
      }
    },
    "command": {
      "type": "object", "additionalProperties": false, "required": ["argv", "cwd"],
      "properties": {
        "argv": { "type": "array", "minItems": 1, "maxItems": 128, "prefixItems": [{ "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]*$" }], "items": { "type": "string", "maxLength": 4096, "pattern": "^[^\u0000]*$" } },
        "cwd": { "$ref": "#/$defs/workspacePath" }
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["cpu", "memory_mib", "disk_mib"],
      "properties": {
        "cpu": { "const": 1 },
        "memory_mib": { "const": 256 },
        "disk_mib": { "type": "integer", "minimum": 64, "maximum": 8192 },
        "timeout_s": { "type": "integer", "minimum": 1, "maximum": 2147483 }
      }
    },
    "min_resources": { "$ref": "#/$defs/resourceMinimums" },
    "layer_sources": {
      "type": "object", "propertyNames": { "$ref": "#/$defs/digest" }, "maxProperties": 16,
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["task_id", "path"],
        "properties": { "task_id": { "type": "string", "pattern": "^[0-9a-f-]{36}$" }, "path": { "$ref": "#/$defs/workspacePath" } }
      }
    },
    "shard": {
      "type": "object", "additionalProperties": false, "required": ["index", "count"],
      "properties": { "index": { "type": "integer", "minimum": 0, "maximum": 63 }, "count": { "type": "integer", "minimum": 2, "maximum": 64 } }
    },
    "network": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": { "mode": { "const": "none" } }
    },
    "outputs": {
      "type": "object", "additionalProperties": false, "required": ["paths"],
      "properties": {
        "paths": { "type": "array", "uniqueItems": true, "maxItems": 8, "items": { "$ref": "#/$defs/workspacePath", "not": { "const": "/workspace" } } }
      }
    }
  },
  "$defs": {
    "resourceMinimums": {
      "type": "object", "additionalProperties": false,
      "description": "Minimum task resources selected from the runner's advertised profiles.",
      "properties": {
        "cpu": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "memory_mib": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "disk_mib": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "workspacePath": { "type": "string", "maxLength": 1024, "pattern": "^/workspace(?:/(?!\\.{1,2}(?:/|$))[^/\u0000]+)*$" }
  }
}
