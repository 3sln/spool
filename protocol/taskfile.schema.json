{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:3sln:spool:taskfile:0.1",
  "title": "Spool Taskfile",
  "type": "object",
  "required": ["version", "kind"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "0.1" },
    "kind": { "enum": ["base", "task"] },
    "extends": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/path" } },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "base": { "type": "string", "minLength": 1 },
        "features": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "resources": { "$ref": "urn:3sln:spool:manifest:0.1#/$defs/resourceMinimums" },
        "limits": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "layers": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/layer" } },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "cwd": { "$ref": "urn:3sln:spool:manifest:0.1#/$defs/workspacePath" }
      }
    },
    "task_timeout_s": { "type": "integer", "minimum": 1, "maximum": 2147483 },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "type": "integer", "minimum": 1 },
        "memory_mib": { "type": "integer", "minimum": 1 },
        "disk_mib": { "type": "integer", "minimum": 1 },
        "timeout_s": { "type": "integer", "minimum": 1 }
      }
    },
    "outputs": { "$ref": "urn:3sln:spool:manifest:0.1#/properties/outputs" },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["path", "destination"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "destination": { "$ref": "urn:3sln:spool:manifest:0.1#/$defs/workspacePath" },
        "include": { "type": "array", "items": { "$ref": "#/$defs/path" } },
        "exclude": { "type": "array", "items": { "$ref": "#/$defs/path" } }
      }
    },
    "sourceDiff": {
      "type": "object", "additionalProperties": false, "required": ["format", "argv"],
      "properties": {
        "format": { "enum": ["git", "vcdiff"] },
        "argv": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "strip": { "type": "integer", "minimum": 0, "maximum": 16 }
      },
      "if": { "properties": { "format": { "const": "vcdiff" } } },
      "then": { "not": { "required": ["strip"] } }
    },
    "name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$" },
    "layer": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "kind": { "type": "string", "minLength": 1 },
        "build_resources": { "$ref": "urn:3sln:spool:manifest:0.1#/$defs/resourceMinimums" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "sources" } } },
          "then": {
            "required": ["sources"], "additionalProperties": false,
            "properties": {
              "id": {}, "kind": {},
              "sources": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/source" } },
              "diff": { "$ref": "#/$defs/sourceDiff" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "directory" } } },
          "then": {
            "required": ["path"],
            "additionalProperties": false,
            "properties": {
              "id": {}, "kind": {},
              "path": { "$ref": "#/$defs/path" },
              "previous": { "$ref": "#/$defs/path" },
              "include": { "type": "array", "items": { "$ref": "#/$defs/path" } },
              "exclude": { "type": "array", "items": { "$ref": "#/$defs/path" } }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "archive" } } },
          "then": {
            "required": ["path"],
            "additionalProperties": false,
            "properties": {
              "id": {}, "kind": {},
              "path": { "$ref": "#/$defs/path" },
              "media_type": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "docker" } } },
          "then": {
            "required": ["image", "argv"],
            "additionalProperties": false,
            "properties": {
              "id": {}, "kind": {}, "build_resources": {},
              "image": { "type": "string", "pattern": "^[a-z0-9][a-zA-Z0-9_.:/-]*@sha256:[a-f0-9]{64}$" },
              "argv": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "maxLength": 4096 } },
              "path": { "$ref": "#/$defs/path" },
              "include": { "type": "array", "items": { "$ref": "#/$defs/path" } },
              "exclude": { "type": "array", "items": { "$ref": "#/$defs/path" } },
              "media_type": { "enum": ["application/vnd.oci.image.layer.v1.tar", "application/vnd.oci.image.layer.v1.tar+gzip"] },
              "build_timeout_s": { "type": "integer", "minimum": 1, "maximum": 604800 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "cached" } } },
          "then": {
            "required": ["digest"], "additionalProperties": false,
            "properties": {
              "id": {}, "kind": {},
              "digest": { "$ref": "urn:3sln:spool:manifest:0.1#/$defs/digest" },
              "media_type": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "artifact" } } },
          "then": {
            "required": ["task_id", "path"],
            "additionalProperties": false,
            "properties": {
              "id": {}, "kind": {},
              "task_id": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
              "path": { "$ref": "urn:3sln:spool:manifest:0.1#/$defs/workspacePath" },
              "media_type": { "enum": ["application/vnd.oci.image.layer.v1.tar", "application/vnd.oci.image.layer.v1.tar+gzip"] }
            }
          }
        }
      ]
    }
  }
}
